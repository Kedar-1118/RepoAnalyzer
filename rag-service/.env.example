# LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (required if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Personal Access Token (used by RAG service for cloning repos; optional but recommended for higher rate limits)
GITHUB_TOKEN=your_github_token_here

# Embedding model (HuggingFace model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# LLM Model names
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# Analysis cache settings
CACHE_DB_PATH=./analysis_cache.db
CACHE_TTL_DAYS=7
